{
  "name": "harness-scouter-vscode",
  "displayName": "Harness Scouter",
  "description": "Claude Code \ud2b8\ub79c\uc2a4\ud06c\ub9bd\ud2b8\uc5d0\uc11c \ud558\ub124\uc2a4 \uc124\uacc4 \ud488\uc9c8\uc744 \uce21\uc815\ud55c\ub2e4",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "harnessScouter.showPanel",
        "title": "Harness Scouter: \uc721\uac01\ud615 \ub9ac\ud3ec\ud2b8 \uc5f4\uae30"
      },
      {
        "command": "harnessScouter.scan",
        "title": "Harness Scouter: \ud2b8\ub79c\uc2a4\ud06c\ub9bd\ud2b8 \uc2a4\uce94"
      }
    ],
    "configuration": {
      "title": "Harness Scouter",
      "properties": {
        "harnessScouter.nodePath": {
          "type": "string",
          "default": "node",
          "description": "CLI\ub97c \uc2e4\ud589\ud560 node \uacbd\ub85c. Extension Host\uac00 \uc544\ub2c8\ub77c \uc790\uc2dd \ud504\ub85c\uc138\uc2a4\uc5d0\uc11c \ub3cc\ub9b0\ub2e4."
        },
        "harnessScouter.cliPath": {
          "type": "string",
          "default": "",
          "description": "scouter CLI\uc758 dist/index.js \uacbd\ub85c. \ube44\uc6b0\uba74 \ud655\uc7a5 \uc124\uce58 \uc704\uce58 \uae30\uc900\uc73c\ub85c \ucc3e\ub294\ub2e4."
        },
        "harnessScouter.dbPath": {
          "type": "string",
          "default": "",
          "description": "SQLite \ud30c\uc77c \uacbd\ub85c. \ube44\uc6b0\uba74 \ud648 \ub514\ub809\ud1a0\ub9ac \uc544\ub798 \uae30\ubcf8\uac12\uc744 \uc4f4\ub2e4."
        },
        "harnessScouter.scanOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "\ud655\uc7a5\uc774 \ucf1c\uc9c8 \ub54c \uc99d\ubd84 \uc2a4\uce94\uc744 \ud55c \ubc88 \ub3cc\ub9b0\ub2e4."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --build"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
