{
  "name": "harness-scouter",
  "version": "0.3.0",
  "private": true,
  "description": "Claude Code 트랜스크립트에서 하네스 설계 품질을 측정한다",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --dry 2>/dev/null || tsc --build",
    "scouter": "node --no-warnings packages/cli/dist/index.js",
    "check:docs": "node scripts/checkDocs.mjs",
    "format": "prettier --write .",
    "check:format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
